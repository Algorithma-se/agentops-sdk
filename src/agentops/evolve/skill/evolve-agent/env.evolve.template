# .env.evolve — environment for `uv run agentops evolve replay --env-file .env.evolve`
#
# Copy to the client repo root as `.env.evolve` and make sure it is git-ignored.
# The replay loads ONLY this file (never `.env`), and runs the real agent:
# every hook (incl. after_session) and every tool runs with these credentials.
#
# Rules:
#   - Read-only or sandbox credentials only. Never production write credentials,
#     and never copy values from the production `.env`.
#   - Leave a tool's credentials empty if the agent must not reach that system;
#     the coding agent stops and asks before replaying with side effects.
#   - Keep PII masking on (same provider as production, sandbox credentials).
#   - Add whatever else your client repo's `.env.template` requires for the
#     agents you replay, under the same rules.

#####################
# Replays never send traces (required: the replay refuses to run without it)
#####################
LANGFUSE_SAMPLE_RATE=0
# Replays never read secrets from a vault: the replay sets READ_SECRETS=false
# whatever this file or the shell says.

#####################
# AOS Control (AgentOps): required. Turns on tracing so the replay can
# record its trace events (nothing is sent), and reads AOS
# prompts. A project API key of the project the feedback came from.
#####################
AGENTOPS_HOST=
AGENTOPS_PUBLIC_KEY=
AGENTOPS_SECRET_KEY=
AOS_PROMPT_LABEL=production

#####################
# Environment
#####################
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=plain
# Absolute path to this client repo
PROJECT_ROOT=
PROJECT_TIMEZONE=Europe/Stockholm
# AGENTS_CONFIG_FILE=agents.yaml

#####################
# Cloud provider (PII masking and document reading use it)
# "azure" or "gcp"
#####################
CLOUD_PROVIDER=azure

#####################
# LLM — sandbox / non-production key, same model as production
# LLM_PROVIDER: "azure_openai", "openai" or "mistral"
#####################
LLM_PROVIDER=azure_openai
MODEL_DEPLOYMENT_NAME=
OPENAI_EMBEDDING_MODEL=

# azure_openai
OPENAI_ENDPOINT=
AI_SERVICES_ENDPOINT=
AI_FOUNDRY_PROJECT_ENDPOINT=

# openai
OPENAI_API_KEY=
OPENAI_PROJECT_ID=

# mistral
MISTRAL_API_KEY=
MISTRAL_ENDPOINT=

#####################
# PII masking — keep it on, with sandbox credentials
# Azure: Text Analytics via the AI services endpoint above.
# GCP: DLP in this project.
#####################
GCP_PROJECT_ID=

#####################
# Remote MCP tool servers — read-only keys or a test tenant
# One block per server named in agents.yaml (replace <NAME>). A server
# served from this repository is started by `replay --local-mcp`, which sets
# its MCP_URL_<NAME>; keep its own settings (credentials) in this file too,
# since the replay's processes read only this file.
#####################
# MCP_URL_<NAME>=
# MCP_AUTH_TYPE_<NAME>=
# MCP_API_KEY_<NAME>=

#####################
# Client integrations used by local tools and hooks — read-only or sandbox
# (add the ones your agents and their tool servers use, leave others empty)
#####################
# <INTEGRATION>_API_URL=
# <INTEGRATION>_API_KEY=

#####################
# Conversation store: not used by replays (an in-memory store, nothing is
# written), but core's settings check needs one. These values point
# nowhere on purpose: never put a real database here.
#####################
USE_PG_CONVERSATIONS=true
POSTGRESQL_HOST=replay-unused.invalid
POSTGRESQL_DATABASE=unused
POSTGRESQL_USER=unused

#####################
# Not needed for replays
#####################
# Teams / Google Chat / Outlook sending: leave empty so nothing is sent.
